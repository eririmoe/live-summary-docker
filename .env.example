# Copy only for noninteractive configuration; interactive setup writes .env.
COMPOSE_PROJECT_NAME=live-summary
DATA_DIR=./data
RECORDS_DIR=./records
APP_IMAGE=live-summary:local
APP_UID=1000
APP_GID=1000
RECORDER_IMAGE=ghcr.io/bililiverecorder/bililiverecorder:2.20.0
BREC_HTTP_BASIC_USER=admin
BREC_HTTP_BASIC_PASS=REPLACE_WITH_A_RANDOM_PASSWORD
ADMIN_ORIGIN=http://localhost:8766
ADMIN_COOKIE_SECURE=false
